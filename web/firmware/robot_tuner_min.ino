// robot_tuner_min.ino - generated by Robot Tuner (Robot builder -> Firmware) for "Basel & Nicole robot (ESP32, DRV8833, 3x VL53L1X)".
// Answers Robot Tuner's measurement commands over USB serial, so the Measure page works unchanged.
//
// Board:     ESP32   (arduino-cli FQBN esp32:esp32:esp32)
// Encoders:  quadrature A+B (ESP32 PCNT hardware counter (ESP-IDF pulse_cnt driver), both edges of A and B (x4))
// Driver:    two inputs IN1 / IN2 per motor, both PWM (DRV8833, MX1508, L9110S, TB67H450, L298N with the ENA/ENB jumpers on)
// Sensors:   right = VL53L1X_short, front = VL53L1X_short, left = VL53L1X_short
// Libraries (Arduino Library Manager): "VL53L1X" by Pololu
// Board package: "esp32" by Espressif Systems (Boards Manager).
//
// Commands (115200 baud, one per line; every CAL command also works without the word CAL):
//   CAL TICKS / CAL END        turn each wheel one revolution by hand -> ticks per revolution
//   CAL MAXSPEED               full power 1 s, wheels in the air -> top speed
//   CAL FF                     PWM sweep, wheels in the air -> deadband (ff_static) and PWM per speed (ff_gain)
//   CAL STEP [m/s]             speed step with a simple wheel PI -> time constant
//   CAL DRIVE <m> / CAL DIST <real m> straight drive -> wheel scale
//   CAL SPIN <turns> / CAL TURNS <real> spin in place -> effective track width
//   CAL DIR                    each wheel forward 0.4 s at half power, wheels in the air -> motor and encoder signs
//   CAL TIMED [ms]             full power for ms milliseconds without encoders -> measure the distance yourself
//   CAL VMIN                   PWM ramp both ways, wheels in the air -> slowest steady speed (v_min)
//   RUN [s] / STOP             wall following with the PID below (constant cruise speed), default 10 s
//   CAL TOF [n] [true_mm]      n readings per sensor -> noise, bias, dropouts
//   PING                       is the robot there, and over which link? Robot Tuner sends it every few seconds
//   STATUS                     loop period and reading age
//   LOAD SENSORS / LOAD FINAL  motors off / on (sensor timing test)

// BLUETOOTH SERIAL (classic ESP32): the robot answers over USB AND Bluetooth at the same time. Pair the PC once with
// "RobotTuner-Basel-Nicole" (Windows: Settings -> Bluetooth -> Add device; it gets a COM port "Standard Serial over Bluetooth"),
// then press CONNECT in Robot Tuner and pick that port: the robot can drive on the floor without a cable.
// ESP32-S3 / C3 / C6 have no classic Bluetooth: switch it off in Robot builder -> Firmware.
#include "BluetoothSerial.h"

#include <Wire.h>
#include <driver/pulse_cnt.h>   // ESP-IDF PCNT driver, part of the esp32 board package (core 3.x and 4.x)
#include <VL53L1X.h>
BluetoothSerial SerialBT;
bool cmdFromBt = false;   // the last command came over Bluetooth (PING answers which link)
// RT_IO: every reply goes to USB and Bluetooth; commands are read from both
class TeeIO : public Stream {
 public:
  // Bluetooth only while a PC is connected: with nobody listening its queue fills and every write waits 1 s
  size_t write(uint8_t c) override { Serial.write(c); if (SerialBT.hasClient()) SerialBT.write(c); return 1; }
  size_t write(const uint8_t* b, size_t n) override { Serial.write(b, n); if (SerialBT.hasClient()) SerialBT.write(b, n); return n; }
  int available() override { return Serial.available() + SerialBT.available(); }
  int read() override { if (Serial.available()) { cmdFromBt = false; return Serial.read(); } cmdFromBt = true; return SerialBT.read(); }
  int peek() override { return Serial.available() ? Serial.peek() : SerialBT.peek(); }
  void flush() override { Serial.flush(); SerialBT.flush(); }
};
TeeIO RT_IO;

#ifndef IRAM_ATTR
#define IRAM_ATTR
#endif
struct Meter { long pl, pr; unsigned long us; };   // wheel speed meter (declared first for the Arduino prototype generator)

void linkWatch() {   // tell USB and Bluetooth when a PC opens or closes the Bluetooth port
  static bool was = false; bool now = SerialBT.hasClient();
  if (now != was) { was = now; RT_IO.println(now ? F("LINK bluetooth connected") : F("LINK bluetooth disconnected")); }
}

// ======================= CONFIG (generated; change it here if you rewire) =======================
// motor driver: two inputs IN1 / IN2 per motor, both PWM (DRV8833, MX1508, L9110S, TB67H450, L298N with the ENA/ENB jumpers on)
const int PIN_IN1_L = 25, PIN_IN2_L = 4, PIN_IN1_R = 13, PIN_IN2_R = 12;
const bool STOP_BRAKE = true;   // true: a stopped motor is shorted (brake); false: it turns freely (coast)
const int MOTOR_SIGN_L = -1, MOTOR_SIGN_R = -1;   // flip to -1 if a wheel drives backwards
const int PIN_ENC_L_A = 32, PIN_ENC_L_B = 33, PIN_ENC_R_A = 27, PIN_ENC_R_B = 26;
const int ENC_SIGN_L = -1, ENC_SIGN_R = -1;   // flip to -1 if a wheel counts backwards
const int PIN_SDA = 21, PIN_SCL = 22;
const float WHEEL_DIAMETER_M = 0.045f;
float ticks_per_rev = 8291.5f;     // computed: 7 pulses x 4 edges x gear 296.125 = 8291.5; replace with the CAL TICKS result
float track_w = 0.1249f;             // replace with the CAL TURNS result
const int PWM_MAX = 255;
const int N_SENSORS = 3;
const char* SENSOR_NAME[N_SENSORS] = {"right", "front", "left"};   // = the sensor names in the robot builder
#define HAS_ENCODERS 1
#define LOW_RES 0
// =================================================================================================

// ---- motors ----
bool motorsEnabled = true;
volatile int cmdDirL = 1, cmdDirR = 1;   // sign of the last non-zero command (single-channel encoders use it)
// Two-input driver (DRV8833 style): IN1/IN2 = 0/0 coast, 1/1 brake, PWM/0 forward, 0/PWM reverse.
// STOP_BRAKE also picks the decay between PWM pulses: brake = slow decay (one input HIGH, the other gets the
// inverted PWM; speed is close to proportional to PWM), coast = fast decay (one input PWM, the other LOW).
// Both inputs must be PWM pins. analogWrite(pin, 0 / PWM_MAX) is used for LOW / HIGH so the pin never
// switches between digital and PWM mode.
void motorOut(int in1, int in2, int u) {
  int d = constrain(abs(u), 0, PWM_MAX);
  if (d == 0) { analogWrite(in1, STOP_BRAKE ? PWM_MAX : 0); analogWrite(in2, STOP_BRAKE ? PWM_MAX : 0); return; }
  if (STOP_BRAKE) {
    if (u > 0) { analogWrite(in1, PWM_MAX); analogWrite(in2, PWM_MAX - d); } else { analogWrite(in1, PWM_MAX - d); analogWrite(in2, PWM_MAX); }
  } else {
    if (u > 0) { analogWrite(in1, d); analogWrite(in2, 0); } else { analogWrite(in1, 0); analogWrite(in2, d); }
  }
}
void motorsSetup() { pinMode(PIN_IN1_L, OUTPUT); pinMode(PIN_IN2_L, OUTPUT); pinMode(PIN_IN1_R, OUTPUT); pinMode(PIN_IN2_R, OUTPUT); }
void motorL(int u) { motorOut(PIN_IN1_L, PIN_IN2_L, u); }
void motorR(int u) { motorOut(PIN_IN1_R, PIN_IN2_R, u); }
// l, r: -PWM_MAX..PWM_MAX, positive = forward
void setPwm(int l, int r) {
  if (!motorsEnabled) { l = 0; r = 0; }
  l = constrain(l, -PWM_MAX, PWM_MAX); r = constrain(r, -PWM_MAX, PWM_MAX);
  if (l) cmdDirL = l > 0 ? 1 : -1;
  if (r) cmdDirR = r > 0 ? 1 : -1;
  motorL(l * MOTOR_SIGN_L); motorR(r * MOTOR_SIGN_R);
}

// ---- wheel encoders: cntL() / cntR() = signed ticks, forward positive ----
// PCNT: the ESP32 hardware pulse counter counts every edge of A and B (x4) without using the CPU.
// (ESP-IDF rotary encoder setup. The ESP32Encoder library does the same but does not build on esp32 core 4.0.)
pcnt_unit_handle_t pcntL = NULL, pcntR = NULL;
pcnt_unit_handle_t pcntQuad(int a, int b) {
  pcnt_unit_config_t uc = {}; uc.low_limit = -30000; uc.high_limit = 30000; uc.flags.accum_count = 1;   // accumulate past +-30000
  pcnt_unit_handle_t u = NULL; ESP_ERROR_CHECK(pcnt_new_unit(&uc, &u));
  pcnt_glitch_filter_config_t fc = {}; fc.max_glitch_ns = 1000; ESP_ERROR_CHECK(pcnt_unit_set_glitch_filter(u, &fc));
  pcnt_chan_config_t ca = {}; ca.edge_gpio_num = a; ca.level_gpio_num = b;
  pcnt_chan_config_t cb = {}; cb.edge_gpio_num = b; cb.level_gpio_num = a;
  pcnt_channel_handle_t c0 = NULL, c1 = NULL; ESP_ERROR_CHECK(pcnt_new_channel(u, &ca, &c0)); ESP_ERROR_CHECK(pcnt_new_channel(u, &cb, &c1));
  // same edge / level actions as ESP32Encoder attachFullQuad, so a count direction measured with it still holds
  pcnt_channel_set_edge_action(c0, PCNT_CHANNEL_EDGE_ACTION_DECREASE, PCNT_CHANNEL_EDGE_ACTION_INCREASE);
  pcnt_channel_set_level_action(c0, PCNT_CHANNEL_LEVEL_ACTION_INVERSE, PCNT_CHANNEL_LEVEL_ACTION_KEEP);
  pcnt_channel_set_edge_action(c1, PCNT_CHANNEL_EDGE_ACTION_DECREASE, PCNT_CHANNEL_EDGE_ACTION_INCREASE);
  pcnt_channel_set_level_action(c1, PCNT_CHANNEL_LEVEL_ACTION_KEEP, PCNT_CHANNEL_LEVEL_ACTION_INVERSE);
  pcnt_unit_add_watch_point(u, 30000); pcnt_unit_add_watch_point(u, -30000);
  ESP_ERROR_CHECK(pcnt_unit_enable(u)); pcnt_unit_clear_count(u); ESP_ERROR_CHECK(pcnt_unit_start(u));
  gpio_pullup_en((gpio_num_t)a); gpio_pullup_en((gpio_num_t)b);
  return u;
}
void encSetup() { pcntL = pcntQuad(PIN_ENC_L_A, PIN_ENC_L_B); pcntR = pcntQuad(PIN_ENC_R_A, PIN_ENC_R_B); }
void encPoll() {}
long cntL() { int v = 0; pcnt_unit_get_count(pcntL, &v); return (long)v * ENC_SIGN_L; }
long cntR() { int v = 0; pcnt_unit_get_count(pcntR, &v); return (long)v * ENC_SIGN_R; }
float mPerTick() { return 3.14159265f * WHEEL_DIAMETER_M / ticks_per_rev; }

// ---- distance sensors: every new reading goes through newReading(i, mm); -1 = no valid reading ----
int lastMm[N_SENSORS];
unsigned long readingTimeUs[N_SENSORS], sensorSeq[N_SENSORS];
bool freshInSet[N_SENSORS];
unsigned long lastSetUs = 0, loopPeriodUs = 0;   // the "control loop" = one fresh reading from every sensor
bool setReady = false;                             // a new full set arrived (the wall-following PID runs on it)
void newReading(int i, int mm) {
  lastMm[i] = mm; readingTimeUs[i] = micros(); sensorSeq[i]++; freshInSet[i] = true;
  for (int k = 0; k < N_SENSORS; k++) if (!freshInSet[k]) return;
  unsigned long now = micros(); loopPeriodUs = now - lastSetUs; lastSetUs = now; setReady = true;
  for (int k = 0; k < N_SENSORS; k++) freshInSet[k] = false;
}
VL53L1X tof0;   // sensor 0 "right" VL53L1X_short
VL53L1X tof1;   // sensor 1 "front" VL53L1X_short
VL53L1X tof2;   // sensor 2 "left" VL53L1X_short
bool tofOk[N_SENSORS];
unsigned long tofMissingMs[N_SENSORS];
// XSHUT: LOW = sensor off. All ToF sensors share address 0x29 at power-up, so they are kept off, then woken
// one at a time and moved to their own address. The pin is released (INPUT) instead of driven HIGH because the
// breakout pulls XSHUT up to its own 2.8 V supply.
const int XSHUT_PIN[] = {18, 23, 5};
void tofMissing(int i) { RT_IO.print(F("WARN sensor ")); RT_IO.print(SENSOR_NAME[i]); RT_IO.println(F(" not found: check wiring and XSHUT")); }
void tofSetup() {
  for (int k = 0; k < 3; k++) { pinMode(XSHUT_PIN[k], OUTPUT); digitalWrite(XSHUT_PIN[k], LOW); }
  delay(10);
  // sensor 0 "right": VL53L1X_short, XSHUT GPIO18, address 0x32
  pinMode(18, INPUT); delay(10);
  tof0.setTimeout(500);
  tofOk[0] = tof0.init();
  if (!tofOk[0]) tofMissing(0);
  else {
    tof0.setAddress(0x32);
    tof0.setDistanceMode(VL53L1X::Short);
    tof0.setMeasurementTimingBudget(20000);   // us; the period below must be >= budget + 4 ms
    tof0.startContinuous(25);
  }
  // sensor 1 "front": VL53L1X_short, XSHUT GPIO23, address 0x31
  pinMode(23, INPUT); delay(10);
  tof1.setTimeout(500);
  tofOk[1] = tof1.init();
  if (!tofOk[1]) tofMissing(1);
  else {
    tof1.setAddress(0x31);
    tof1.setDistanceMode(VL53L1X::Short);
    tof1.setMeasurementTimingBudget(20000);   // us; the period below must be >= budget + 4 ms
    tof1.startContinuous(25);
  }
  // sensor 2 "left": VL53L1X_short, XSHUT GPIO5, address 0x30
  pinMode(5, INPUT); delay(10);
  tof2.setTimeout(500);
  tofOk[2] = tof2.init();
  if (!tofOk[2]) tofMissing(2);
  else {
    tof2.setAddress(0x30);
    tof2.setDistanceMode(VL53L1X::Short);
    tof2.setMeasurementTimingBudget(20000);   // us; the period below must be >= budget + 4 ms
    tof2.startContinuous(25);
  }
}
void sensorsSetup() {
  for (int i = 0; i < N_SENSORS; i++) { lastMm[i] = -1; readingTimeUs[i] = micros(); sensorSeq[i] = 0; freshInSet[i] = false; }
  tofSetup();
  for (int i = 0; i < N_SENSORS; i++) tofMissingMs[i] = 0;
}
unsigned long lastTofPollUs = 0;
void pollSensors() {
  if (micros() - lastTofPollUs >= 1000) {   // ask the ToF sensors at most every 1 ms (each ask is an I2C read)
    lastTofPollUs = micros();
    if (!tofOk[0]) { if (millis() - tofMissingMs[0] >= 25) { tofMissingMs[0] = millis(); newReading(0, -1); } }   // missing sensor: report dropouts
    else if (tof0.dataReady()) { tof0.read(false); newReading(0, tof0.ranging_data.range_status == VL53L1X::RangeValid ? (int)tof0.ranging_data.range_mm : -1); }
    if (!tofOk[1]) { if (millis() - tofMissingMs[1] >= 25) { tofMissingMs[1] = millis(); newReading(1, -1); } }   // missing sensor: report dropouts
    else if (tof1.dataReady()) { tof1.read(false); newReading(1, tof1.ranging_data.range_status == VL53L1X::RangeValid ? (int)tof1.ranging_data.range_mm : -1); }
    if (!tofOk[2]) { if (millis() - tofMissingMs[2] >= 25) { tofMissingMs[2] = millis(); newReading(2, -1); } }   // missing sensor: report dropouts
    else if (tof2.dataReady()) { tof2.read(false); newReading(2, tof2.ranging_data.range_status == VL53L1X::RangeValid ? (int)tof2.ranging_data.range_mm : -1); }
  }
}

void i2cSetup() {
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(400000);
}

// ---- wall-following PID (RUN): constant cruise speed, the same formula as the simulator ----
//   e = clamp(left - right - setpoint, +-ERROR_CLIP); integral = clamp(integral + e dt, +-INTEGRAL_LIMIT)
//   d_filt = alpha d_raw + (1 - alpha) d_filt; turn = clamp(KP e + KI integral + KD d_filt, +-V_MAX)
//   base = V_MIN + SPEED_FRAC (V_MAX - V_MIN); v_left = base - turn, v_right = base + turn, clamped to +-V_MAX
const float PID_KP = 0.457387f, PID_KI = 0.000167f, PID_KD = 0.255282f;
const float PID_SPEED_FRAC = 0.75f;   // cruise = 0.120 m/s
const float PID_V_MAX = 0.156f, PID_V_MIN = 0.013f;   // measured top speed, slowest steady speed (CAL VMIN)
const float PID_ERROR_CLIP = 0.08f, PID_INTEGRAL_LIMIT = 0.5f, PID_D_ALPHA = 0.3f;   // alpha per 50 ms
const float PID_SETPOINT = 0.0f;   // wanted left - right (0 = centred)
const int PID_LEFT = 2, PID_RIGHT = 0;   // sensors looking most to the left / right
const float SENSOR_MAX_M[N_SENSORS] = {1.3f, 1.3f, 1.3f};   // no reading = nothing within range
#define CAN_RUN 1

// no extra commands in this sketch (the ESP32 install firmware adds SET / GET / SAVE here)
bool extraCommand(const char* u, const char* orig) { return false; }

// ---- waiting: keeps the encoders (AS5600) and, when asked, the sensors running ----
void idle(bool sensors) { encPoll(); if (sensors) pollSensors(); }
void waitMs(unsigned long ms, bool sensors = false) { unsigned long t = millis(); while (millis() - t < ms) idle(sensors); }

// ---- wheel speed (m/s) since the last read of a meter ----
void meterStart(Meter& m) { m.pl = cntL(); m.pr = cntR(); m.us = micros(); }
#if LOW_RES
// few ticks per revolution: speed = distance of one timed edge / time between two edges
float periodSpeed(volatile unsigned long& lastEdge, volatile unsigned long& period, int dir) {
  noInterrupts(); unsigned long p = period, t = lastEdge; interrupts();
  unsigned long since = micros() - t;
  if (p == 0 || since > 300000UL) return 0;   // no edge for 0.3 s: stopped
  if (since > p) p = since;                    // the next edge is late: the wheel is slowing down
  return dir * TICKS_PER_EDGE * mPerTick() / (p * 1e-6f);
}
#endif
float meterRead(Meter& m, float& vl, float& vr) {   // returns dt (s)
  long l = cntL(), r = cntR(); unsigned long now = micros();
  float dt = max(1e-4f, (now - m.us) * 1e-6f);
#if LOW_RES
  vl = periodSpeed(edgeUsL, periodUsL, dirL()); vr = periodSpeed(edgeUsR, periodUsR, dirR());
#else
  vl = (l - m.pl) * mPerTick() / dt; vr = (r - m.pr) * mPerTick() / dt;
#endif
  m.pl = l; m.pr = r; m.us = now;
  return dt;
}
// average speed over ms milliseconds
void avgSpeeds(unsigned long ms, float& vl, float& vr) {
#if LOW_RES
  float sl = 0, sr = 0; int n = 0; Meter m; meterStart(m); unsigned long t0 = millis();
  while (millis() - t0 < ms) { float a, b; waitMs(5); meterRead(m, a, b); sl += a; sr += b; n++; }
  vl = sl / max(1, n); vr = sr / max(1, n);
#else
  Meter m; meterStart(m); waitMs(ms); meterRead(m, vl, vr);
#endif
}

// simple wheel speed PI with feed-forward (for STEP / DRIVE / SPIN)
float ff_static = 30, ff_gain = 400;   // PWM, PWM per (m/s): replaced by CAL FF
float wkp = 300, wki = 2000;           // PWM per (m/s), PWM per m
float iL = 0, iR = 0;
int piOne(float tg, float v, float& integ, float dt) {
  if (fabs(tg) < 1e-3) { integ = 0; return 0; }
  float e = tg - v; integ += e * dt;
  float u = (tg > 0 ? ff_static : -ff_static) + ff_gain * tg + wkp * e + wki * integ;
  return (int)constrain(u, -PWM_MAX, PWM_MAX);
}
void wheelPI(float tl, float tr, float vl, float vr, float dt) { setPwm(piOne(tl, vl, iL, dt), piOne(tr, vr, iR, dt)); }

char line[64]; int lineLen = 0;   // the command being typed

